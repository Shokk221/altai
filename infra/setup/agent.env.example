# Altai v2 agent — sunucu başına env dosyası.
# Kopyası /etc/altai/agent-<SERVER_SLUG>.env olarak durur, izinleri 0600.
# İçinde RCON ve veritabanı şifresi var — repoya ASLA girmez.

# --- Bu agent hangi sunucu ---
# Slug, systemd instance adıyla AYNI olmalı: altai-agent@squad-01 -> squad-01
SERVER_SLUG=squad-01
SERVER_NAME=[TR] TÜRK ALTAI COMMUNITY #1

# --- Panel bağlantısı ---
# Agent'ın Postgres'e erişimi YOK ve olmamalı. Hem gerçek zamanlı eventler hem
# kalıcı veri bu tek WS üzerinden api'ye gider; api veritabanına yazan tek
# yerdir. Böylece Postgres hiçbir yere açılmaz ve oyun sunucusundaki bir süreç
# veritabanı kimlik bilgisi taşımaz.
# Agent DIŞA doğru bağlanır — oyun sunucusunda içe açık port gerekmez.
AGENT_API_WS_URL=wss://panel.altaisquad.com/agent-ws
# Paneldeki AGENT_SHARED_SECRET ile birebir aynı olmalı.
AGENT_SHARED_SECRET=

# --- Spool (bağlantı kopukken eventlerin biriktiği dizin) ---
# /data altında OLMALI, yoksa konteyner yeniden yaratılınca kuyruk kaybolur.
AGENT_SPOOL_DIR=/data/altai-run/spool

# --- Squad motoru ---
# real: vendored SquadJS (gerçek log parser + RCON). fixture: sahte test motoru.
AGENT_ENGINE=real
# Kurulum dizinine göre mutlak yol — install-agent.sh bunu otomatik doldurur.
SQUADJS_VENDOR_ENTRY=/opt/altai/packages/squad/vendor/agent-entry/index.js

# --- RCON ---
# DİKKAT: Altai barındırma ortamında 127.0.0.1 ÇALIŞMAZ.
# Oyun konteyneri host ağını paylaşıyor ve loopback, diğer müşterileri korumak
# için filtrelenmiş. Ölçüm (2026-08-08):
#   nc -z 127.0.0.1 21114      -> Connection refused
#   nc -z 178.63.113.47 21114  -> succeeded
# Bu yüzden sunucunun genel IP'si kullanılır:
RCON_HOST=178.63.113.47
RCON_PORT=21114
RCON_PASSWORD=

# --- Log dizini (SquadGame.log'un BULUNDUĞU KLASÖR, dosyanın kendisi değil) ---
# Altai oyun konteynerinde LinuxGSM'in tamamı /data altında:
SQUAD_LOG_DIR=/data/serverfiles/SquadGame/Saved/Logs
# İkinci (turnuva) sunucu ayrı konteyner — kendi /data'sındaki yolu kullanın.

# Sadece log mesajında görünür, işlevsel değil.
SQUAD_QUERY_PORT=27165

# debug: her event loglanır (ilk kurulumda faydalı, sonra info'ya çekin).
LOG_LEVEL=info
