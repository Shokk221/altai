# --- Postgres ---
DATABASE_URL=postgres://altai:altai@localhost:5432/altai

# --- Discord OAuth / Bot ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CALLBACK_URL=http://localhost:3001/auth/discord/callback
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Session ---
SESSION_SECRET=change-me

# --- Break-glass super admin (Discord'dan bağımsız acil giriş) ---
BREAK_GLASS_USER=
BREAK_GLASS_PASSWORD_HASH=

# --- İlk kurulum: pnpm db:seed:bootstrap-admin çalıştırırken kullanılır,
#     .env'de kalıcı tutulmasına gerek yok, tek seferlik.
# BOOTSTRAP_DISCORD_ROLE_ID=

# --- Steam Web API ---
STEAM_API_KEY=

# --- BattleMetrics (sadece tools/bm-export arşivleme için, geçiş sonrası silinir) ---
# Token: battlemetrics.com/developers -> yeni token. Org sahibi bir hesap olmalı,
# yoksa ban/not/flag uçları 403 döner (pnpm bm:probe ile önceden görürsünüz).
BATTLEMETRICS_TOKEN=
BM_ORGANIZATION_ID=
BM_EXPORT_DIR=./bm-archive
# Sunucu ID'leri — battlemetrics.com/servers/squad/<ID> adresindeki sayı.
# ÖNEMLİ: verilmezse /servers?filter[organizations] ile keşfedilmeye çalışılır,
# ama bu filtre BM dokümantasyonunda yok. Elle vermek her zaman daha güvenli.
BM_SERVER_IDS=
# Geçmiş (player-count/unique/time-played) uçlarının tarandığı başlangıç tarihi.
BM_HISTORY_START=2020-01-01T00:00:00Z
# Saniyedeki istek üst sınırı. 429 alırsanız düşürün (arşiv yine devam eder).
BM_REQUESTS_PER_SECOND=4

# --- Agent <-> API WS ---
# Agent'ın Postgres'e erişimi YOK: kalıcı veri de bu WS üzerinden api'ye gider,
# api veritabanına yazan tek yerdir. Üretim kurulumu: infra/panel/ ve infra/setup/
AGENT_API_WS_URL=ws://localhost:3001/agent-ws
AGENT_SHARED_SECRET=
# Bağlantı kopukken eventlerin biriktiği dizin (üretimde /data altında olmalı)
AGENT_SPOOL_DIR=./.agent-spool

# --- Agent kimliği (agent'ın kendi .env'i, oyun sunucusunda) ---
SERVER_SLUG=squad-01
SERVER_NAME=Altai Squad #1
# fixture: gerçek sunucu olmadan test. real: ported SquadJS + SQUADJS_VENDOR_ENTRY zorunlu.
AGENT_ENGINE=fixture
# AGENT_ENGINE=real olduğunda: paketlenmiş, gerçek (ported) SquadJS motoru.
# apps/agent/src/index.ts konumuna göre relative path (bkz. packages/squad/vendor/):
# SQUADJS_VENDOR_ENTRY=../../../packages/squad/vendor/agent-entry/index.js

# --- Web'in canlı durum WS'e bağlanacağı adres (tarayıcıdan erişilebilir olmalı) ---
NEXT_PUBLIC_API_WS_URL=ws://localhost:3001/ws

# --- RCON (agent tarafında, sunucu başına .env) ---
RCON_HOST=127.0.0.1
RCON_PORT=21114
RCON_PASSWORD=
# AGENT_ENGINE=real için ek olarak gerekli (bkz. packages/squad/vendor/agent-entry):
# SQUAD_LOG_DIR=/path/to/SquadGame/Saved/Logs
# SQUAD_QUERY_PORT=27165
