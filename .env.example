# --- İlk kurulum: pnpm db:seed:bootstrap-admin çalıştırırken kullanılır,
#     .env'de kalıcı tutulmasına gerek yok, tek seferlik.
# BOOTSTRAP_DISCORD_ROLE_ID=

# --- Steam Web API ---
STEAM_API_KEY=

# --- BattleMetrics (sadece tools/bm-export arşivleme için, geçiş sonrası silinir) ---
