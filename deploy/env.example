# Panel konteyneri sırları -> /app/.env  (gitignore'da, host diskinde kalıcı)
#
# DATABASE_URL BURAYA YAZILMAZ. Konteyner onu ortamda veriyor:
#   echo $DATABASE_URL
# Buraya da yazarsanız hangisinin kazandığı belirsizleşir; deploy.sh bunu
# yakalayıp durur.

NODE_ENV=production

# --- Ters vekil ---
# api 127.0.0.1'e bağlı ve önünde Caddy var. Bu ayar olmadan Fastify her
# istekte vekilin adresini görür; hız sınırı istemcileri ayırt edemez ve
# break-glass'ın 5/dk sınırı herkese ortak tek kovaya düşer (tek saldırgan
# bütün adminleri kilitler). Caddy aynı makinedeyse 'loopback' doğru değer.
# Vekil arkasında DEĞİLSENİZ boş bırakın: açıkken istemci X-Forwarded-For
# uydurup sınırı atlayabilir.
TRUST_PROXY=loopback

# --- Dışarıdan görünen adres (reverse proxy tek alan adı, yol ile ayırıyor) ---
WEB_APP_URL=https://panel.altaisquad.com
# NEXT_PUBLIC_* değişkenleri BUILD anında gömülür — değiştirirseniz
# deploy.sh'i tekrar çalıştırın, sadece restart yetmez.
NEXT_PUBLIC_API_URL=https://panel.altaisquad.com/api
NEXT_PUBLIC_API_WS_URL=wss://panel.altaisquad.com/ws

# --- Oturum ---
# openssl rand -hex 32
SESSION_SECRET=

# --- Discord OAuth + bot ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CALLBACK_URL=https://panel.altaisquad.com/api/auth/discord/callback

# --- Break-glass süper admin (Discord kesintisinde panele girmek için) ---
# pnpm hash-password '<sifre>' çıktısını yapıştırın.
BREAK_GLASS_USER=
BREAK_GLASS_PASSWORD_HASH=

# --- Oyun sunucusundaki agent'ın kimlik doğrulaması ---
# Oyun konteynerindeki agent env'inde AYNI değer olmalı.
# openssl rand -hex 32
AGENT_SHARED_SECRET=

# --- Steam Web API (isim/avatar çözümleme) ---
STEAM_API_KEY=
