{
  "name": "altai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @altai/db generate",
    "db:migrate": "pnpm --filter @altai/db migrate",
    "db:seed:bootstrap-admin": "pnpm --filter @altai/db seed:bootstrap-admin",
    "hash-password": "pnpm --filter @altai/hash-password start --"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@biomejs/biome": "^1.9.0"
  }
}
