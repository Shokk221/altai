{
  "name": "altai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @altai/db generate",
    "db:migrate": "pnpm --filter @altai/db migrate",
    "db:seed:bootstrap-admin": "pnpm --filter @altai/db seed:bootstrap-admin",
    "hash-password": "pnpm --filter @altai/hash-password start --",
    "bm:export": "pnpm --filter @altai/bm-export start --",
    "bm:probe": "pnpm --filter @altai/bm-export start -- --probe",
    "bm:report": "pnpm --filter @altai/bm-export start -- --report",
    "bm:analyze": "pnpm --filter @altai/bm-import start --",
    "bm:import": "pnpm --filter @altai/bm-import start --",
    "mongo:import": "pnpm --filter @altai/mongo-import start --",
    "db:seed:role-mapping": "pnpm --filter @altai/db seed:role-mapping --",
    "db:backfill:chat": "pnpm --filter @altai/db backfill:chat",
    "mongo:chat": "pnpm --filter @altai/mongo-import chat --"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "next": "^16.2.12"
  }
}
